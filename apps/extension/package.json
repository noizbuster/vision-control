{
  "name": "@vision-control/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chromium extension for Vision Control (WXT + React).",
  "scripts": {
    "dev": "wxt",
    "dev-pair": "node scripts/dev-with-pair.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && node --test scripts/dev-pair-helpers.test.mjs"
  },
  "dependencies": {
    "@vision-control/change-ir": "workspace:*",
    "@vision-control/change-journal": "workspace:*",
    "@vision-control/daemon-client": "workspace:*",
    "@vision-control/editor-core": "workspace:*",
    "@vision-control/element-identity": "workspace:*",
    "@vision-control/geometry": "workspace:*",
    "@vision-control/inspector-core": "workspace:*",
    "@vision-control/interaction-machine": "workspace:*",
    "@vision-control/layout-engine": "workspace:*",
    "@vision-control/overlay-ui": "workspace:*",
    "@vision-control/preview-engine": "workspace:*",
    "@vision-control/protocol": "workspace:*",
    "@vision-control/security": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vision-control/context-compiler": "workspace:*",
    "@vision-control/source-registry": "workspace:*",
    "@vision-control/source-resolver": "workspace:*",
    "@vision-control/testing": "workspace:*",
    "@vision-control/verification-engine": "workspace:*",
    "@vision-control/workspace-index": "workspace:*",
    "@wxt-dev/module-react": "catalog:",
    "jsdom": "29.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "@types/ws": "catalog:",
    "wxt": "catalog:"
  }
}
