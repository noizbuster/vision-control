{
  "name": "@vision-control/vite-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite plugin that injects dev-only opaque source markers into host JSX/TSX.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@vision-control/source-registry": "workspace:*",
    "magic-string": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/babel__traverse": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
