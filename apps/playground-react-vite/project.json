{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "playground-react-vite",
  "sourceRoot": "apps/playground-react-vite/src",
  "projectType": "library",
  "tags": ["platform:browser", "type:fixture", "scope:playground-react-vite"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/playground-react-vite"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/playground-react-vite"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/playground-react-vite"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/playground-react-vite"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "apps/playground-react-vite"
      },
      "outputs": ["{projectRoot}/playwright-report", "{projectRoot}/test-results"]
    }
  }
}
