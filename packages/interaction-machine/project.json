{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "interaction-machine",
  "sourceRoot": "packages/interaction-machine/src",
  "projectType": "library",
  "tags": ["platform:isomorphic", "type:library", "scope:interaction-machine"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "packages/interaction-machine"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/interaction-machine"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/interaction-machine"
      }
    }
  }
}
