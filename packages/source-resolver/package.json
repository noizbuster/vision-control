{
  "name": "@vision-control/source-resolver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resolves a selection identity to a source candidate using source markers, CSS tokens, and fallback search.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vision-control/css-modules": "workspace:*",
    "@vision-control/element-identity": "workspace:*",
    "@vision-control/next-react": "workspace:*",
    "@vision-control/source-registry": "workspace:*",
    "@vision-control/svelte": "workspace:*",
    "@vision-control/tailwind": "workspace:*",
    "@vision-control/vanilla-css": "workspace:*",
    "@vision-control/vue": "workspace:*",
    "@vision-control/workspace-index": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vision-control/testing": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
