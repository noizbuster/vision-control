{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tools-nx-plugin",
  "sourceRoot": "tools/nx-plugin/src",
  "projectType": "library",
  "tags": ["platform:node", "scope:nx-plugin", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "tools/nx-plugin"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "tools/nx-plugin"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "tools/nx-plugin"
      }
    },
    "scaffold": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/scripts/scaffold-all.js",
        "cwd": "tools/nx-plugin"
      },
      "dependsOn": ["build"]
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/scripts/boundaries.ts",
        "cwd": "tools/nx-plugin"
      }
    }
  }
}
