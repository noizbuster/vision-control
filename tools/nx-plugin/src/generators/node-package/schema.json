{
  "$schema": "http://json-schema.org/schema",
  "title": "Node Package Generator",
  "description": "Scaffold a Node library or app (platform:node). Defaults to type:library; pass type:'app' for a Node app.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "$default": { "$source": "argv", "index": 0 } },
    "directory": { "type": "string", "alias": "d" },
    "description": { "type": "string" },
    "scope": { "type": "string" },
    "type": { "type": "string", "enum": ["library", "app"], "default": "library" }
  },
  "required": ["name", "directory"]
}
