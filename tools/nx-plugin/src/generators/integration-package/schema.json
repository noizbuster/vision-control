{
  "$schema": "http://json-schema.org/schema",
  "title": "Integration Package Generator",
  "description": "Scaffold a build-tool integration (platform:node, type:integration), e.g. a Vite plugin.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "$default": { "$source": "argv", "index": 0 } },
    "directory": { "type": "string", "alias": "d" },
    "description": { "type": "string" },
    "scope": { "type": "string" }
  },
  "required": ["name", "directory"]
}
