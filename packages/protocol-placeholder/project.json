{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "protocol-placeholder",
  "sourceRoot": "packages/protocol-placeholder/src",
  "projectType": "library",
  "tags": ["platform:isothermal", "scope:protocol", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/protocol-placeholder"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/protocol-placeholder"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/protocol-placeholder"
      }
    }
  }
}
