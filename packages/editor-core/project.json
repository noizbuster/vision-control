{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "editor-core",
  "sourceRoot": "packages/editor-core/src",
  "projectType": "library",
  "tags": ["platform:isomorphic", "type:library", "scope:editor-core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "packages/editor-core"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/editor-core"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/editor-core"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/*.tgz"],
      "options": {
        "command": "pnpm pack",
        "cwd": "packages/editor-core"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"publish is a no-op stub; gated behind a release ADR (PRD 32.3)\""
      }
    }
  }
}
