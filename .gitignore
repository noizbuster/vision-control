# dependencies
node_modules/

# build outputs
dist/
build/
.next/
.nuxt/
.output/
.turbo/
coverage/

# playwright e2e artifacts (generated by `playwright test`)
test-results/
playwright-report/

# daemon runtime data (SQLite db + artifacts) created under a workspace root
.vision-control/

# nx - the entire runtime dir (cache, workspace-data, install) is derived
# from nx.json + the project files, so it is never committed.
.nx/

# wxt generated types and config
.wxt/

