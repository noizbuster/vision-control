{
  "name": "@vision-control/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node library skeleton for @vision-control/cli.",
  "bin": {
    "vision-control": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vision-control/context-compiler": "workspace:*",
    "@vision-control/daemon-client": "workspace:*",
    "@vision-control/mcp-server": "workspace:*",
    "@vision-control/security": "workspace:*",
    "@vision-control/source-resolver": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
