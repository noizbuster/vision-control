{
  "$schema": "http://json-schema.org/schema",
  "title": "Fixture App Generator",
  "description": "Scaffold a test-fixture app (platform:browser, type:fixture) exercised by the e2e matrix.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "$default": { "$source": "argv", "index": 0 } },
    "directory": { "type": "string", "alias": "d" },
    "description": { "type": "string" },
    "scope": { "type": "string" }
  },
  "required": ["name", "directory"]
}
