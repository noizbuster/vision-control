# pnpm workspace settings.
# The pnpm version itself is pinned via the `packageManager` field in
# package.json and activated through Corepack (`corepack enable`).

# Reject installs when the active Node/pnpm version does not match `engines`.
engine-strict=true

# Link workspace packages by name so `workspace:` protocol resolves locally.
link-workspace-packages=true

# Preserve pnpm's strict isolated node_modules (do not shamefully hoist).
# Package boundary discipline relies on isolation.
shamefully-hoist=false

# Auto-install peer dependencies (pnpm 11 default, made explicit for clarity).
auto-install-peers=true
