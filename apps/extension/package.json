{
  "name": "@vision-control/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chromium extension for Vision Control (WXT + React).",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vision-control/change-ir": "workspace:*",
    "@vision-control/daemon-client": "workspace:*",
    "@vision-control/element-identity": "workspace:*",
    "@vision-control/geometry": "workspace:*",
    "@vision-control/inspector-core": "workspace:*",
    "@vision-control/protocol": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "catalog:",
    "jsdom": "29.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wxt": "catalog:"
  }
}
