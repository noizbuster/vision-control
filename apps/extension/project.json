{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "extension",
  "sourceRoot": "apps/extension/src",
  "projectType": "application",
  "tags": ["platform:browser", "type:app", "scope:extension"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wxt build",
        "cwd": "apps/extension"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wxt",
        "cwd": "apps/extension"
      }
    },
    "dev-pair": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/dev-with-pair.mjs",
        "cwd": "apps/extension"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/extension"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run && node --test scripts/dev-pair-helpers.test.mjs",
        "cwd": "apps/extension"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "apps/extension"
      },
      "outputs": ["{projectRoot}/playwright-report", "{projectRoot}/test-results"]
    }
  }
}
