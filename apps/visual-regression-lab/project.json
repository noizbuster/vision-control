{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "visual-regression-lab",
  "sourceRoot": "apps/visual-regression-lab/src",
  "projectType": "library",
  "tags": ["platform:browser", "type:fixture", "scope:visual-regression-lab"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "apps/visual-regression-lab"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/visual-regression-lab"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/visual-regression-lab"
      }
    }
  }
}
